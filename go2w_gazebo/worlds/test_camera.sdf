<?xml version="1.0"?>
<sdf version="1.9">
  <world name="camera_test">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.2 0.2 0.2 1</background></scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="ground">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
    </link></model>
    <!-- Distinct colors and known positions test both optical axes and K projection. -->
    <model name="red_target"><static>true</static><pose>2 0.4 0.75 0 0 0</pose><link name="target">
      <visual name="visual"><geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.5 0 0 1</emissive></material>
      </visual>
    </link></model>
    <model name="green_target"><static>true</static><pose>2 -0.4 0.75 0 0 0</pose><link name="target">
      <visual name="visual"><geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 0.5 0 1</emissive></material>
      </visual>
    </link></model>
    <model name="blue_target"><static>true</static><pose>2 0 0.22 0 0 0</pose><link name="target">
      <visual name="visual"><geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 0.5 1</emissive></material>
      </visual>
    </link></model>
  </world>
</sdf>
